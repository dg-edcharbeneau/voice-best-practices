# Copy this file to `.env` and fill in your keys. BOTH keys live ONLY on the
# server (see server/server.mjs) and are never sent to the browser.

# --- Deepgram (ears + mouth: streaming STT and TTS) --------------------------
# Get one at https://console.deepgram.com
# Used to mint short-lived browser tokens; the raw key never leaves the server.
DEEPGRAM_API_KEY=

# --- OpenAI (brain: the LLM behind /api/chat) --------------------------------
# Get one at https://platform.openai.com
# The server (/api/chat) uses this to answer chat turns and streams the reply.
# NOTE: the server reads the LLM key from THIS FILE (not the shell), so a global
# `export OPENAI_API_KEY=…` in your ~/.zshrc (e.g. an AWS Bedrock token) can't
# shadow it. Put your real OpenAI key here.
OPENAI_API_KEY=

# Optional: which OpenAI model /api/chat uses (default: gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Endpoint for the OpenAI-compatible API. Leave BLANK for OpenAI's default
# (https://api.openai.com/v1). The server reads this from the file (not the
# shell), so a stray global `export OPENAI_BASE_URL=…` can't reroute the call.
# Only fill it if you truly use an OpenAI-compatible proxy.
OPENAI_BASE_URL=

# Port the Node server listens on. In dev, Vite (5173) proxies /api/* here.
# In prod, this server also serves the built app.
PORT=3000

# Time-to-live (seconds) for the browser tokens minted by /api/token.
# The token TTL only needs to cover the WebSocket handshake; once a socket
# is open, token expiry does not close it. Keep this short.
TOKEN_TTL_SECONDS=60

# Copy this file to `.env` and fill in your keys. BOTH keys live ONLY on the
# server (see server/server.mjs) and are never sent to the browser.

# --- Deepgram (ears + mouth: streaming STT and TTS) --------------------------
# Get one at https://console.deepgram.com
# Used to mint short-lived browser tokens; the raw key never leaves the server.
DEEPGRAM_API_KEY=

# --- OpenAI (brain: the LLM behind CopilotKit's runtime) ---------------------
# Get one at https://platform.openai.com
# The CopilotKit runtime (server-side) uses this to answer chat turns.
# NOTE: the server reads the LLM key from THIS FILE (not the shell), so a global
# `export OPENAI_API_KEY=…` in your ~/.zshrc (e.g. an AWS Bedrock token) can't
# shadow it. Put your real OpenAI key here.
# To use a different provider, swap the adapter in server/server.mjs (see README).
OPENAI_API_KEY=

# Optional: which model the runtime uses (default: gpt-4o-mini).
#
# gpt-4o-mini is the cheapest way to see the demo work, but it follows the
# ~2,400-token persona in server/prompt.mjs only loosely — expect it to drift
# back into tidy, list-shaped answers. Step up a tier if the voice matters.
#
# Claude works here without touching any code, via Anthropic's OpenAI-compatible
# endpoint — set OPENAI_API_KEY to an Anthropic key and uncomment:
#   OPENAI_BASE_URL=https://api.anthropic.com/v1/
#   OPENAI_MODEL=claude-opus-5      # or claude-sonnet-5, or claude-haiku-4-5
# Latency is what to tune for here, since a reply is only spoken once it is
# fully generated: haiku is the quickest, opus the best at holding the persona.
# Note the compat layer ignores reasoning-effort and does no prompt caching, so
# the persona is re-billed in full every turn. For production, swap in
# CopilotKit's AnthropicAdapter instead (see README → Swapping the LLM provider).
OPENAI_MODEL=gpt-4o-mini

# Endpoint for the OpenAI-compatible API. Leave BLANK for OpenAI's default
# (https://api.openai.com/v1). The server reads this from the file (not the
# shell), so a stray global `export OPENAI_BASE_URL=…` can't reroute the call.
# Only fill it if you truly use an OpenAI-compatible proxy.
OPENAI_BASE_URL=

# Optional: the CopilotKit runtime sends anonymous usage telemetry by default.
# Uncomment to opt out (https://docs.copilotkit.ai/telemetry).
# COPILOTKIT_TELEMETRY_DISABLED=true

# Port the Node server listens on. In dev, Vite (5173) proxies /api/* here.
# In prod, this server also serves the built app.
PORT=3000

# Time-to-live (seconds) for the browser tokens minted by /api/token.
# The token TTL only needs to cover the WebSocket handshake; once a socket
# is open, token expiry does not close it. Keep this short.
TOKEN_TTL_SECONDS=60

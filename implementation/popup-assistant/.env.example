# Copy this file to `.env` and fill in your key. The key lives ONLY on the
# server (see server/server.mjs) and is never sent to the browser — the browser
# authenticates Deepgram's WebSockets with short-lived tokens minted here
# (Best practice #1).

# --- Deepgram (ears + mouth: streaming STT and TTS) --------------------------
# Get one at https://console.deepgram.com
# This is the ONLY key this prototype needs — the chat "brain" is a canned stub
# on the server, so there is no LLM key.
DEEPGRAM_API_KEY=

# Port the Node server listens on. In dev, Vite (5173) proxies /api/* here.
# In prod, this server also serves the built app.
PORT=3000

# Time-to-live (seconds) for the browser tokens minted by /api/token.
# The token TTL only needs to cover the WebSocket handshake; once a socket is
# open, token expiry does not close it. Keep this short.
TOKEN_TTL_SECONDS=60
